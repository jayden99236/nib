// Recursion, and the fact that a wasm call is just a call.

fn fib(n: i32) -> i32 {
  if n < 2 {
    return n;
  }
  return fib(n - 1) + fib(n - 2);
}

export fn main() -> i32 {
  let mut total = 0;
  let mut i = 0;

  while i < 20 {
    total = total + fib(i);
    i = i + 1;
  }

  return total;
}
